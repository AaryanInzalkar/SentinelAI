FROM python:3.11-slim
 
WORKDIR /app
 
# System deps needed by opencv-python-headless
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
 
COPY requirements.txt .
 
# Install CPU-only torch first (avoids pulling multi-GB Nvidia CUDA packages
# that are unnecessary for local/demo CPU inference)
RUN pip install --no-cache-dir torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu
 
# Install the rest of the requirements (torch is already satisfied, so this
# will not re-trigger the GPU download)
RUN pip install --no-cache-dir -r requirements.txt
 
COPY backend/ backend/
 
EXPOSE 8000
 
ENV PYTHONPATH=/app
 
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
 