FROM python:3.11-slim
 
WORKDIR /app
 
COPY frontend/requirements.txt .
RUN pip install --no-cache-dir \
    streamlit==1.60.0 \
    plotly==6.9.0 \
    pandas==3.0.3 \
    requests==2.34.2 \
    pillow==12.3.0
 
COPY frontend/ frontend/
 
EXPOSE 8501
 
ENV PYTHONPATH=/app
 
CMD ["streamlit", "run", "frontend/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
 